# Copy this file to .env and fill in the values. .env is never committed.
# All come from the Sarvam Agents dashboard (agents.sarvam.ai).

# The AGENT's API key (Agents platform). This is the one the bot uses.
INTERVIEW_BOT_API_KEY=
# Your general Sarvam key (speech APIs). Not accepted by the Agents platform.
SARVAM_API_KEY=

SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# The agent (app) to use. AGENT_ID works too.
AGENT_ID=
# Optional: pin a published version of the agent.
SARVAM_APP_VERSION=

# Fairness check: after each interview the candidate's microphone is checked for
# other voices with Sarvam speech-to-text (uses SARVAM_API_KEY). "off" skips it.
SARVAM_VOICE_CHECK=on

# --- Used when interviews are sent from ProHire -------------------------------
# The address candidates open the interview on (what goes in the email link).
# Empty = the address ProHire used to reach this server (fine on one machine only).
PUBLIC_URL=
# Where the ProHire console runs (it calls this server from the browser).
PROHIRE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The HR mailbox the invite email is sent from. Without SMTP_HOST, ProHire opens
# the recruiter's own mail app instead. Port 587 uses STARTTLS, 465 uses SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
