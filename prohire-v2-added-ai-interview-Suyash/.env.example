# The live AI interviewer (OpenAI Realtime). Without a key, interviews use the
# browser voice instead. The key stays on the dev server; it never reaches the browser.
OPENAI_API_KEY=sk-your-openai-key
# Optional overrides
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
